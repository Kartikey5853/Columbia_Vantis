# Shopify Storefront Access Token for Columbia Sportswear India
SHOPIFY_TOKEN=your_shopify_storefront_access_token_here

# Supabase Configuration (Source of Truth)
# Obtain from your Supabase Dashboard: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_secret_key_here
# Alternative name: SUPABASE_SECRET_KEY=sb_secret_...

# Optional: Direct PostgreSQL connection string for automatic migrations
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Scraper Concurrency and Timeouts
TATA_SCRAPE_TIMEOUT_SECONDS=3600